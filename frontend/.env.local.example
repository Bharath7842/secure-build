SAST_API_URL=http://localhost:8000

# Optional. Shared with the backend's FRONTEND_PROXY_SECRET so sign-in rate
# limits count each browser's address instead of this server's.
FRONTEND_PROXY_SECRET=

# Optional. Public origin(s) of this app when it sits behind a reverse proxy
# (comma separated), e.g. https://securebuild.example.com
APP_ORIGIN=

# Optional. Session cookies are Secure (HTTPS only) in production builds; set
# to false only to run a production build over plain http.
# SESSION_COOKIE_SECURE=false
