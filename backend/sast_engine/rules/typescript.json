[
  {
    "id": "angular-bypass-security-trust",
    "title": "Angular sanitizer bypassed",
    "description": "bypassSecurityTrust* disables Angular's built-in XSS sanitisation for that value. Safe only if the input is genuinely trusted and never attacker-influenced \u2014 verify the value's origin. Generalized from legacy-audit patterns (regex_data/NPC-*.md, regex_data/NPG-*.md).",
    "cwe": "CWE-79",
    "severity": "HIGH",
    "category": "code",
    "owasp": "A03:2021-Injection",
    "languages": [
      "typescript",
      "javascript"
    ],
    "frameworks": [],
    "pattern": "bypassSecurityTrust(?:Html|Script|Style|Url|ResourceUrl)\\s*\\((?!\\s*['\\\"`])",
    "examples": {
      "match": [
        "return this.sanitizer.bypassSecurityTrustHtml(this.content);"
      ],
      "no_match": [
        "return this.sanitizer.bypassSecurityTrustResourceUrl('https://www.youtube.com/embed/x');"
      ]
    }
  },
