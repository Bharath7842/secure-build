  {
    "id": "angular-http-interceptor-token-to-any-url",
    "title": "HTTP interceptor attaches the token to every URL",
    "description": "An HttpInterceptor adds the Authorization header without checking the request URL, so the token is also sent to third-party hosts the app calls.",
    "cwe": "CWE-201",
    "severity": "LOW",
    "category": "code",
    "owasp": "A01:2021-Broken-Access-Control",
    "languages": [
      "typescript",
      "javascript"
    ],
    "frameworks": [
      "Angular"
    ],
    "pattern": "implements\\s+HttpInterceptor(?=[\\s\\S]{0,800}?setHeaders[\\s\\S]{0,200}?Authorization)(?![\\s\\S]{0,1200}?(?:startsWith|includes|apiUrl|baseUrl|environment\\.\\w*[Uu]rl|\\.url\\.match|indexOf))",
    "examples": {
      "match": [
        "export class AuthInterceptor implements HttpInterceptor {\n  intercept(req, next) {\n    return next.handle(req.clone({ setHeaders: { Authorization: `Bearer ${this.token}` } }));\n  }\n}"
      ],
      "no_match": [
        "export class AuthInterceptor implements HttpInterceptor {\n  intercept(req, next) {\n    if (!req.url.startsWith(environment.apiUrl)) { return next.handle(req); }\n    return next.handle(req.clone({ setHeaders: { Authorization: `Bearer ${this.token}` } }));\n  }\n}"
      ]
    }
  },
